{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } },
  "Guardrails": { "ReviewAt": 0.5, "BlockAt": 0.8, "MaxInputChars": 4000 },
  "Models": { "Small": "gpt-4.1-nano", "Large": "gpt-4.1-mini" },
  "SemanticCache": { "Embedder": "local", "Threshold": 0.8, "TtlMinutes": 60 },
  "Azure": {
    "Language":      { "Endpoint": "https://YOUR-LANGUAGE-RESOURCE.cognitiveservices.azure.com/" },
    "ContentSafety": { "Endpoint": "https://YOUR-CONTENT-SAFETY-RESOURCE.cognitiveservices.azure.com/" }
  }
}
