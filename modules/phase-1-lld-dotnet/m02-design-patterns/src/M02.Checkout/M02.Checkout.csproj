<Project Sdk="Microsoft.NET.Sdk">

  <!-- Gives access to real ASP.NET Core types (WebApplication, DI, Minimal APIs)
       so pattern files can show their Program.cs wiring. Ships with the SDK, no NuGet package. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- EF Core (in-memory provider pulls in EF Core itself) for the Repository / Unit of Work critique. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
  </ItemGroup>

</Project>
