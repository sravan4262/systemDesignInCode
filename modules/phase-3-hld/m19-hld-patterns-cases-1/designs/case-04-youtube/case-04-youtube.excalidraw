      "boundElements": null,
      "updated": 1700000000000,
      "link": null,
      "locked": false,
      "text": "WRITE touches: Upload Service, raw Blob (direct, SAS),\nVideo metadata + outbox, Kafka, orchestrator,\ntranscode workers, processed Blob, finalize step.\nViews: View Service -> Kafka -> consumer -> counts.\n\nREAD touches: Video Service, Redis, Cosmos on a miss\n(metadata only). The video bytes go CDN -> Blob origin\nand never pass through our services.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "WRITE touches: Upload Service, raw Blob (direct, SAS),\nVideo metadata + outbox, Kafka, orchestrator,\ntranscode workers, processed Blob, finalize step.\nViews: View Service -> Kafka -> consumer -> counts.\n\nREAD touches: Video Service, Redis, Cosmos on a miss\n(metadata only). The video bytes go CDN -> Blob origin\nand never pass through our services.",
      "lineHeight": 1.25,
      "autoResize": true
    },
