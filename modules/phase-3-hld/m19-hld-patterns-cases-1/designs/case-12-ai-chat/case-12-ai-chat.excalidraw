    {
      "id": "Bnote",
      "type": "text",
      "x": 910.0,
      "y": 1295.0,
      "width": 655.0,
      "height": 180.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 2715,
      "version": 1,
      "versionNonce": 2722,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1700000000000,
      "link": null,
      "locked": false,
      "text": "WHY A SEMANTIC CACHE: thousands of people ask the same thing in\ndifferent words ('new leave policy?', 'how many days off now?').\nMatch by meaning (question vectors close enough), but ONLY for the\nsame permission groups and the same document versions, so a\ncached answer never leaks a document someone can't see, and a\nchanged document makes old answers stale automatically.\n\nQUOTA: the model has a tokens-per-minute limit. APIM caps each\nuser; a 429 from the main deployment spills to a second region.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "WHY A SEMANTIC CACHE: thousands of people ask the same thing in\ndifferent words ('new leave policy?', 'how many days off now?').\nMatch by meaning (question vectors close enough), but ONLY for the\nsame permission groups and the same document versions, so a\ncached answer never leaks a document someone can't see, and a\nchanged document makes old answers stale automatically.\n\nQUOTA: the model has a tokens-per-minute limit. APIM caps each\nuser; a 429 from the main deployment spills to a second region.",
      "lineHeight": 1.25,
      "autoResize": true
    }
  ],
