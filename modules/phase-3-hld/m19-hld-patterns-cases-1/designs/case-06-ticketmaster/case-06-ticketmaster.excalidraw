    {
      "id": "Asum",
      "type": "text",
      "x": 1530.0,
      "y": 600.0,
      "width": 843.0,
      "height": 180.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
