    {
      "id": "Bnote",
      "type": "text",
      "x": 1530.0,
      "y": 1550.0,
      "width": 625.0,
      "height": 140.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 3415,
      "version": 1,
      "versionNonce": 3422,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1700000000000,
      "link": null,
      "locked": false,
      "text": "ORDER: 1 join -> 2 admitted in a batch of K -> 3 poll returns\nthe access token -> 4 seat map -> 5 hold -> 6 checkout (row A).\n\nWHY A TOKEN: the queue decides who goes next; the signed token\nENFORCES it. APIM checks it on seat map, holds and checkout, so\nbots and refreshers can't skip the line: booking only ever sees\nthe K users let in. Row C shows the same flow step by step.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ORDER: 1 join -> 2 admitted in a batch of K -> 3 poll returns\nthe access token -> 4 seat map -> 5 hold -> 6 checkout (row A).\n\nWHY A TOKEN: the queue decides who goes next; the signed token\nENFORCES it. APIM checks it on seat map, holds and checkout, so\nbots and refreshers can't skip the line: booking only ever sees\nthe K users let in. Row C shows the same flow step by step.",
      "lineHeight": 1.25,
      "autoResize": true
    },
