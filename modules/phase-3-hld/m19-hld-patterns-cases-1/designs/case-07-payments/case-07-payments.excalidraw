    {
      "id": "Asum",
      "type": "text",
      "x": 1530.0,
      "y": 330.0,
      "width": 585.0,
      "height": 220.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 2519,
      "version": 1,
      "versionNonce": 2526,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1700000000000,
      "link": null,
      "locked": false,
      "text": "NEVER CHARGE TWICE, layer by layer:\n1 caller's Idempotency-Key is UNIQUE in Payments: a retry\n  gets the stored result, not a second payment\n2 the processor gets OUR paymentId as its idempotency key\n3 capture / void / refund are conditional UPDATEs on status\n4 a timeout = 'unknown': the recovery worker ASKS the\n  processor what happened instead of charging again\n5 webhooks are deduped by event_id\n\nRECONCILIATION catches whatever slipped through:\nevery day, our rows vs. the processor's settlement report.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "NEVER CHARGE TWICE, layer by layer:\n1 caller's Idempotency-Key is UNIQUE in Payments: a retry\n  gets the stored result, not a second payment\n2 the processor gets OUR paymentId as its idempotency key\n3 capture / void / refund are conditional UPDATEs on status\n4 a timeout = 'unknown': the recovery worker ASKS the\n  processor what happened instead of charging again\n5 webhooks are deduped by event_id\n\nRECONCILIATION catches whatever slipped through:\nevery day, our rows vs. the processor's settlement report.",
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "id": "fB",
      "type": "rectangle",
      "x": 0.0,
