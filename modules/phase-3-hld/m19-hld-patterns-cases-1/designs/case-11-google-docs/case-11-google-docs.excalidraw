    {
      "id": "Bsum",
      "type": "text",
      "x": 1530.0,
      "y": 1220.0,
      "width": 635.0,
      "height": 160.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 3093,
      "version": 1,
      "versionNonce": 3100,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1700000000000,
      "link": null,
      "locked": false,
      "text": "EVERY EDIT: client sends { baseRev, op } -> the doc's owner node\n1 transforms it against ops the client hasn't seen (OT)\n2 gives it the next rev, 3 appends it to the op log,\n4 acks the sender and broadcasts to the other editors.\nOne node orders a doc's edits, so everyone converges.\n\nOPEN: latest snapshot + the ops after it. Owner node dies ->\nits lease expires, another node rebuilds from snapshot + log.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "EVERY EDIT: client sends { baseRev, op } -> the doc's owner node\n1 transforms it against ops the client hasn't seen (OT)\n2 gives it the next rev, 3 appends it to the op log,\n4 acks the sender and broadcasts to the other editors.\nOne node orders a doc's edits, so everyone converges.\n\nOPEN: latest snapshot + the ops after it. Owner node dies ->\nits lease expires, another node rebuilds from snapshot + log.",
      "lineHeight": 1.25,
      "autoResize": true
    },
