      "updated": 1700000000000,
      "link": null,
      "locked": false,
      "text": "WHAT CHANGES: 1 cap live editors at 100 (the rest view only),\n2 the owner batches ops every 50 ms and writes the op log\nonce per batch, 3 publishes each batch ONCE to a pub/sub\nchannel, 4 every gateway node fans it out to its own viewers,\nthrottled; viewers see no live cursors. 5 late joiners load a\nCDN-cached snapshot taken every 30 s, plus a short tail.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "WHAT CHANGES: 1 cap live editors at 100 (the rest view only),\n2 the owner batches ops every 50 ms and writes the op log\nonce per batch, 3 publishes each batch ONCE to a pub/sub\nchannel, 4 every gateway node fans it out to its own viewers,\nthrottled; viewers see no live cursors. 5 late joiners load a\nCDN-cached snapshot taken every 30 s, plus a short tail.",
      "lineHeight": 1.25,
      "autoResize": true
    }
