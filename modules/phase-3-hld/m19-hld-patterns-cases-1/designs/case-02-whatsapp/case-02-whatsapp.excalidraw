      "boundElements": null,
      "updated": 1700000000000,
      "link": null,
      "locked": false,
      "text": "WRITE touches: Gateway, Chat Service, Seq counter (INCR),\nMessages store, Kafka, Delivery worker, Presence,\nBob's gateway OR Notification Hubs. Receipts: Receipt\nService -> Receipts store -> Kafka -> Alice's gateway.\n\nREAD touches: Sync Service, user_chats, Seq counters,\nrecent cache, Messages store on a miss. Live delivery is\na PUSH (write path); reads happen on reconnect / history.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "WRITE touches: Gateway, Chat Service, Seq counter (INCR),\nMessages store, Kafka, Delivery worker, Presence,\nBob's gateway OR Notification Hubs. Receipts: Receipt\nService -> Receipts store -> Kafka -> Alice's gateway.\n\nREAD touches: Sync Service, user_chats, Seq counters,\nrecent cache, Messages store on a miss. Live delivery is\na PUSH (write path); reads happen on reconnect / history.",
      "lineHeight": 1.25,
      "autoResize": true
    },
