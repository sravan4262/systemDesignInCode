    {
      "id": "Bnote",
      "type": "text",
      "x": 1490.0,
      "y": 1120.0,
      "width": 764.0,
      "height": 160.0,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 2603,
      "version": 1,
      "versionNonce": 2610,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1700000000000,
      "link": null,
      "locked": false,
      "text": "ORDER: 1 the next minute is already in memory -> 2 at 23:59:30 publish all\n10M runs EARLY with fireAt = 00:00:00, interleaved by tenant -> 3 Kafka holds\nthem -> 4 executors (scaled out at 23:59: the spike is predictable) prefetch\nand wait -> at 00:00:00: 5 skip deleted / paused jobs, apply the tenant limit\n-> 6 call -> 7 save runs in batches.\nWHY: 10M calls can't all start in one second, so the burst drains in ~10 s,\nfairly across tenants. Jobs that don't need :00 exactly can pick 'spread'\n(a fixed random second in the minute), which flattens the spike.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ORDER: 1 the next minute is already in memory -> 2 at 23:59:30 publish all\n10M runs EARLY with fireAt = 00:00:00, interleaved by tenant -> 3 Kafka holds\nthem -> 4 executors (scaled out at 23:59: the spike is predictable) prefetch\nand wait -> at 00:00:00: 5 skip deleted / paused jobs, apply the tenant limit\n-> 6 call -> 7 save runs in batches.\nWHY: 10M calls can't all start in one second, so the burst drains in ~10 s,\nfairly across tenants. Jobs that don't need :00 exactly can pick 'spread'\n(a fixed random second in the minute), which flattens the spike.",
      "lineHeight": 1.25,
      "autoResize": true
    },
