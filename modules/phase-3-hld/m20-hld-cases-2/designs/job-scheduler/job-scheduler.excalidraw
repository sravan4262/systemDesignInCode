      "roundness": null,
      "seed": 3611,
      "version": 1,
      "versionNonce": 3618,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1700000000000,
      "link": null,
      "locked": false,
      "text": "Steps 1-7: one job's life. Steps 8-9: leases are short (10 s) and renewed every 3 s. When Scheduler Service B dies, the other copies take its shards, reload them from Jobs\nand re-fire every run after the shard's fired-up-to checkpoint. A run can be sent twice (B may have published it just before dying), so the Runs\nUNIQUE (jobId, scheduledTime) check and the Idempotency-Key header make a repeat harmless: delivery is AT LEAST ONCE, not exactly once.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Steps 1-7: one job's life. Steps 8-9: leases are short (10 s) and renewed every 3 s. When Scheduler Service B dies, the other copies take its shards, reload them from Jobs\nand re-fire every run after the shard's fired-up-to checkpoint. A run can be sent twice (B may have published it just before dying), so the Runs\nUNIQUE (jobId, scheduledTime) check and the Idempotency-Key header make a repeat harmless: delivery is AT LEAST ONCE, not exactly once.",
      "lineHeight": 1.25,
      "autoResize": true
    }
  ],
  "appState": {
    "gridSize": 20,
    "viewBackgroundColor": "#ffffff"
